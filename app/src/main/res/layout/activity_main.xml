<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_black"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:letterSpacing="0.1"
        android:text="FITLOG // GYM"
        android:textColor="@color/gym_red"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_select_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/spinner_routines"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:text="SELECT WORKOUT FOCUS"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner_routines"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="24dp"
        android:background="@color/gym_surface"
        android:paddingHorizontal="12dp" />

    <Button
        android:id="@+id/btn_start_quick"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/spinner_routines"
        android:backgroundTint="@color/gym_red"
        android:text="START WORKOUT SESSION"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/extra_nav_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btn_browse_routines"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_history"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_surface_variant"
            android:text="HISTORY"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_profile"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_surface_variant"
            android:text="PROFILE"
            android:textColor="@color/white" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_browse_routines"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/dark_surface_variant"
        android:text="BROWSE EXERCISE LIBRARY"
        android:textColor="@color/white" />

</RelativeLayout>
