<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_black"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="ADD CUSTOM EXERCISE"
        android:textColor="@color/gym_red"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_new_exercise_name"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/gym_surface"
        android:hint="Exercise Name (e.g. Incline Bench)"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white" />

    <Button
        android:id="@+id/btn_save_exercise"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/gym_red"
        android:text="SAVE &amp; RETURN"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_cancel_exercise"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/dark_surface_variant"
        android:text="CANCEL"
        android:textColor="@color/white" />

</LinearLayout>
